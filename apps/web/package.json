{
  "name": "@deskcue/web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build && node scripts/check-bundle-size.mjs dist",
    "build:embed": "vite build --config vite.embed.config.ts && node scripts/check-static-entry-size.mjs dist-embed index.js 110000 30000 && node scripts/check-static-entry-size.mjs dist-embed RemoteDeskCueApp 1100000 280000 && node scripts/finalize-embed-build.mjs && node scripts/check-bundle-size.mjs dist-embed 550000",
    "test": "node ../../scripts/test/web-node.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage --testTimeout=10000",
    "test:accessibility": "vitest run src/test/accessibility.unit.test.tsx",
    "test:e2e": "node ../../scripts/test/web-e2e.mjs",
    "test:e2e:optional": "playwright test",
    "test:release": "npm run test && npm run test:unit:coverage && npm run typecheck && npm run typecheck:test && npm run lint",
    "test:release:e2e": "npm run test:release && npm run test:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/*.mjs\" playwright.config.ts vite.config.ts vite.embed.config.ts vite.chunks.ts vitest.config.ts",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@deskcue/protocol": "file:../../packages/protocol",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "es-module-lexer": "2.3.1",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "sass": "^1.101.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "4.1.10"
  }
}

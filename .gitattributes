# Normalize text, source, documentation, and configuration files to LF.
* text=auto eol=lf

# Images and other binary media.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.mp4 binary
*.png binary
*.webp binary
*.avif binary
*.pdf binary

# Fonts.
*.eot binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary

# Archives and compressed artifacts.
*.7z binary
*.bz2 binary
*.gz binary
*.rar binary
*.tar binary
*.tgz binary
*.xz binary
*.zip binary

# Executables and native libraries.
*.dll binary
*.exe binary
*.node binary
